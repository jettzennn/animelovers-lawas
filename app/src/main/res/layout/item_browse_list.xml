<?xml version="1.0" encoding="utf-8"?>
<!-- Item list Jelajahi — adaptasi layout_browse_recycle01.xml asli. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:textColor="?attr/textColor"
    android:orientation="vertical"
    android:id="@+id/row_latest_layoute"
    android:background="?attr/bgColor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:textColor="?attr/textColor"
        android:orientation="vertical"
        android:background="?attr/bgColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="2dp"
        app:cardBackgroundColor="?attr/bgColor">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:textSize="14sp"
                android:textColor="?attr/textColor"
                android:ellipsize="end"
                android:id="@+id/genreTextAll"
                android:background="?attr/bgColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="2"
                android:layout_below="@+id/maxepisode"
                android:layout_marginEnd="5dp"
                android:layout_alignStart="@+id/titleViewBrows" />

            <TextView
                android:textSize="14sp"
                android:textColor="?attr/textColor"
                android:id="@+id/maxepisode"
                android:background="?attr/bgColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/statusText"
                android:layout_marginEnd="5dp"
                android:layout_alignStart="@+id/titleViewBrows" />

            <TextView
                android:textSize="14sp"
                android:textColor="?attr/textColor"
                android:id="@+id/statusText"
                android:background="?attr/bgColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/titleViewBrows"
                android:layout_marginEnd="5dp"
                android:layout_alignStart="@+id/titleViewBrows" />

            <TextView
                android:textSize="18sp"
                android:textColor="?attr/textColor"
                android:ellipsize="end"
                android:gravity="bottom"
                android:id="@+id/titleViewBrows"
                android:background="?attr/bgColor"
                android:layout_width="246dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxLines="2"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="5dp"
                android:layout_toEndOf="@+id/posterViewBrows" />

            <ImageView
                android:textColor="?attr/textColor"
                android:id="@+id/posterViewBrows"
                android:background="?attr/bgColor"
                android:layout_width="105dp"
                android:layout_height="135dp"
                android:scaleType="fitCenter"
                app:srcCompat="@android:color/white" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
