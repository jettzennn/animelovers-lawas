<?xml version="1.0" encoding="utf-8"?>
<!-- Item riwayat — adaptasi layout_history_recycle.xml asli. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:textColor="?attr/textColor"
    android:orientation="vertical"
    android:background="?attr/bgColor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="2dp"
    android:layout_marginRight="2dp"
    android:layout_marginBottom="2dp"
    app:cardCornerRadius="2dp"
    app:cardElevation="2dp"
    app:cardMaxElevation="2dp">

    <RelativeLayout
        android:textColor="?attr/textColor"
        android:orientation="vertical"
        android:id="@+id/row_history_layout"
        android:background="?attr/bgColor"
        android:layout_width="match_parent"
        android:layout_height="135dp">

        <ImageView
            android:textColor="?attr/textColor"
            android:id="@+id/posterhistoryView"
            android:background="?attr/bgColor"
            android:layout_width="105dp"
            android:layout_height="135dp"
            android:scaleType="fitXY"
            app:srcCompat="@android:color/white" />

        <TextView
            android:textSize="20sp"
            android:textColor="?attr/textColor"
            android:ellipsize="end"
            android:gravity="top|left"
            android:id="@+id/titlehistoryView"
            android:background="?attr/bgColor"
            android:layout_width="252dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="2"
            android:layout_alignParentTop="true"
            android:layout_marginStart="110dp"
            android:layout_alignParentStart="true" />

        <TextView
            android:textSize="18sp"
            android:textColor="?attr/textColor"
            android:ellipsize="end"
            android:gravity="bottom|left"
            android:id="@+id/episodehistoryView"
            android:background="?attr/bgColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_above="@+id/timehistoryView"
            android:textAlignment="center"
            android:layout_alignStart="@+id/titlehistoryView" />

        <TextView
            android:textSize="16sp"
            android:textColor="?attr/textColor"
            android:ellipsize="end"
            android:gravity="bottom|left"
            android:id="@+id/timehistoryView"
            android:background="?attr/bgColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:maxLines="1"
            android:layout_alignParentBottom="true"
            android:textAlignment="center"
            android:layout_alignStart="@+id/titlehistoryView" />

        <ImageView
            android:textColor="?attr/textColor"
            android:id="@+id/ImageViewTrash"
            android:background="?attr/bgColor"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginBottom="20dp"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="15dp"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/trash" />
    </RelativeLayout>
</androidx.cardview.widget.CardView>
