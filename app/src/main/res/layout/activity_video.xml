<?xml version="1.0" encoding="utf-8"?>
<!-- Player — adaptasi activity_video.xml asli. ExoPlayer 2.10.1 diganti Media3.
     Layout kontrol kustom dipakai lewat app:controller_layout_id.
     v2: + WebView embed (fallback terakhir, desain.md §14.5) + teks
     "Memuat video…" di atas ProgressBar (desain.md §14.3). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_layout"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <FrameLayout
        android:id="@+id/fullscreen_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/exoPlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:controller_layout_id="@layout/exo_playback_control_view"
            app:show_buffering="never" />
        <!-- v2.0.7 #12: SATU indikator loading saja — spinner bawaan
             PlayerView (show_buffering) DIMATIKAN. Sebelumnya dua spinner
             tampil bersamaan (spinner PlayerView + ProgressBar aplikasi
             dengan teks "Memuat video…"). Yang dipertahankan: ProgressBar +
             teks aplikasi (diatur VideoPlayActivity.showInitialLoading /
             onPlaybackStateChanged) — seperti aslinya yang hanya punya
             satu ProgressBar tanpa teks "Memuat". -->
    </FrameLayout>

    <!-- Mode WebView (embed) — bilah atas minimal: FAB kembali + judul +
         label "480p" + tombol "720p" (bila ada kandidat 720p). -->
    <LinearLayout
        android:id="@+id/webViewContainer"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/webViewTopBar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#4d000000"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/webViewBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fabSize="mini"
                app:backgroundTint="@color/putih"
                app:srcCompat="@drawable/ic_arrow_back_black_24dp" />

            <TextView
                android:id="@+id/webViewTitle"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />

            <TextView
                android:id="@+id/webViewQualityLabel"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/webViewQuality720"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:visibility="gone"
                android:background="@drawable/rounded_corners"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="720p" />

            <!-- Unduh di mode WebView (v2.0.5, D1) — tombol yang sama seperti
                 di kontrol Media3; default gone, visibilitas diatur
                 updateDownloadUi() (hanya bila ada file .mp4 Pixeldrain). -->
            <ImageView
                android:id="@+id/webViewDownload"
                android:visibility="gone"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/unduh"
                app:srcCompat="@drawable/download_new" />
        </LinearLayout>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/memuatVideoText"
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:text="@string/memuat_video" />

    <ProgressBar
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/progressBar"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:layout_alignParentBottom="true" />
</FrameLayout>
