<?xml version="1.0" encoding="utf-8"?>
<!-- Item Episode Baru — adaptasi layout_update_recycle.xml asli. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/row_latest_layoute"
    android:padding="4dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/posterView"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:scaleType="fitXY"
        app:srcCompat="@android:color/white" />

    <TextView
        android:textSize="12sp"
        android:textColor="@android:color/darker_gray"
        android:ellipsize="end"
        android:gravity="bottom"
        android:id="@+id/titleView"
        android:background="@android:color/white"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:maxLines="1"
        android:layout_alignBottom="@+id/posterView"
        android:textAlignment="center"
        android:layout_alignEnd="@+id/posterView" />

    <TextView
        android:textSize="10sp"
        android:textColor="@color/putih"
        android:id="@+id/statusTextUpdate"
        android:background="@drawable/rounded_corners"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/titleView"
        android:layout_alignStart="@+id/posterView" />

    <TextView
        android:textSize="12sp"
        android:textColor="@color/putih"
        android:id="@+id/EpisodeUpdate"
        android:background="@drawable/rounded_corners"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="5dp"
        android:layout_alignEnd="@+id/posterView" />
</RelativeLayout>
