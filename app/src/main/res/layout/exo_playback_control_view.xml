<?xml version="1.0" encoding="utf-8"?>
<!-- Kontrol player kustom — adaptasi exo_playback_control_view.xml asli.
     DIHAPUS: banner_layout_video (iklan), reportimg (tombol lapor),
     brigness_layout (panel brightness — Unknown di aslinya).
     DITAMPILKAN LANGSUNG: screenmode + play_mode (di XML asli "gone",
     visibilitasnya dikendalikan kode — v1 tanpa iklan, jadi selalu tampil).
     DefaultTimeBar + PlayerView berasal dari library Media3. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="#4d000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabvid"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_alignTop="@+id/judulne"
        android:layout_marginStart="20dp"
        app:backgroundTint="@color/putih"
        app:fabSize="mini"
        app:srcCompat="@drawable/ic_arrow_back_black_24dp" />

    <FrameLayout
        android:id="@+id/volume_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/volume_size_layout"
            android:background="@color/putih"
            android:visibility="visible"
            android:layout_width="300dp"
            android:layout_height="70dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="15dp">

                    <TextView
                        android:gravity="center"
                        android:id="@+id/volume_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/volume" />
                </LinearLayout>

                <SeekBar
                    android:gravity="center"
                    android:id="@+id/seekVol"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginBottom="10dp"
                    android:max="255"
                    android:layout_centerVertical="true" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/play_pause_layout"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true">

        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="71dp"
            android:layout_height="52dp">

            <ImageView
                android:layout_gravity="center"
                android:id="@+id/prev_play_overlay"
                android:visibility="visible"
                android:layout_width="35dp"
                android:layout_height="35dp"
                app:srcCompat="@drawable/previous_play_off" />

            <ImageView
                android:layout_gravity="center"
                android:id="@+id/prev_play_png"
                android:layout_width="35dp"
                android:layout_height="35dp"
                app:srcCompat="@drawable/previous_play" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/exo_rew"
            style="@style/ExoMediaButton.Rewind" />

        <ImageButton
            android:layout_gravity="center"
            android:id="@+id/exo_play"
            style="@style/ExoMediaButton.Play" />

        <ImageButton
            android:layout_gravity="center"
            android:id="@+id/exo_pause"
            style="@style/ExoMediaButton.Pause" />

        <ImageButton
            android:id="@+id/exo_ffwd"
            style="@style/ExoMediaButton.FastForward" />

        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="71dp"
            android:layout_height="52dp">

            <ImageView
                android:layout_gravity="center"
                android:id="@+id/next_play_overlay"
                android:visibility="visible"
                android:layout_width="35dp"
                android:layout_height="35dp"
                app:srcCompat="@drawable/next_play_off" />

            <ImageView
                android:layout_gravity="center"
                android:id="@+id/next_play_png"
                android:layout_width="35dp"
                android:layout_height="35dp"
                app:srcCompat="@drawable/exo_icon_next" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/seek_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_alignParentBottom="true">

        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:id="@+id/exo_position"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/exo_progress"
            android:focusable="false"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1" />

        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:id="@+id/exo_duration"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/judulne"
        android:paddingTop="60dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true">

        <TextView
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:gravity="right"
            android:id="@+id/textViewTITLE"
            android:paddingTop="1dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_alignParentTop="true"
            android:layout_toStartOf="@+id/postervideo" />

        <ImageView
            android:id="@+id/postervideo"
            android:layout_width="60dp"
            android:layout_height="80dp"
            android:layout_marginRight="20dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/splashh" />

        <TextView
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:gravity="right"
            android:id="@+id/textViewEPISODE"
            android:paddingTop="10dp"
            android:paddingRight="5dp"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textViewTITLE"
            android:layout_alignEnd="@+id/textViewTITLE" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:layout_above="@+id/play_pause_layout"
        android:layout_marginStart="40dp"
        android:layout_alignParentStart="true">

        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/menu_kiri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/rotateimg"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="5dp"
                app:srcCompat="@drawable/rotate" />

            <TextView
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/screenmode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="5dp"
                android:text="@string/layar_auto" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:layout_above="@+id/play_pause_layout"
        android:layout_marginEnd="40dp"
        android:layout_alignParentEnd="true">

        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/menu_kanan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/resolution"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="5dp"
                app:srcCompat="@drawable/hd_icon" />

            <!-- Unduh (v2.0.5, D1): ganti jalan masuk lama lewat dialog mode.
                 Tampil hanya bila ada file .mp4 langsung (Pixeldrain) —
                 visibilitas diatur updateDownloadUi(); default gone supaya
                 tidak berkedip sebelum episode ter-resolve. -->
            <ImageView
                android:id="@+id/downloadBtn"
                android:visibility="gone"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="5dp"
                android:contentDescription="@string/unduh"
                app:srcCompat="@drawable/download_new" />

            <ImageView
                android:id="@+id/volView"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="5dp"
                app:srcCompat="@drawable/volume" />

            <TextView
                android:textSize="12sp"
                android:textColor="@color/putih"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/play_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="5dp"
                android:text="@string/putar_otomatis" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:id="@+id/kualitas_video"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/judulne"
        android:layout_alignParentEnd="true" />
</RelativeLayout>
