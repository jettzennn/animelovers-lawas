<?xml version="1.0" encoding="utf-8"?>
<!-- AnimeLovers Revival — manifest. Nama aplikasi "AnimLovers" (tanpa versi). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Izin: hanya yang dipakai fitur v1. TIDAK ADA izin lokasi/Bluetooth/WiFi —
         itu jejak SDK iklan aslinya, bukan fitur (PRD §3.2). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Untuk DownloadManager di Android 9 ke bawah saja (API 29+ tidak butuh). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".AnimeloversApp"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:logo="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.main.MainActivity"
            android:label="@string/app_name" />

        <activity
            android:name=".ui.detail.DetailActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme.TransparentTheme" />

        <activity
            android:name=".ui.episode.EpisodeActivity"
            android:label="@string/app_name" />

        <activity
            android:name=".ui.episode.LainnyaActivity"
            android:label="@string/app_name" />

        <activity
            android:name=".ui.player.VideoPlayActivity"
            android:configChanges="screenSize|orientation|keyboardHidden"
            android:label="@string/app_name"
            android:theme="@style/FullscreenTheme" />

        <activity
            android:name=".ui.settings.SettingActivity"
            android:label="@string/app_name" />

        <activity
            android:name=".ui.console.ConsoleActivity"
            android:label="@string/app_name" />

        <!-- v2.0.12: Login Facebook — App ID saja (string resource).
             App Secret TIDAK PERNAH ditulis di sini/di mana pun.
             Nilai "0" = placeholder (langkah A3 belum selesai); login
             Facebook gagal dengan pesan jujur sampai diganti App ID asli. -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />

        <!-- v2.0.9 item 7: FileProvider untuk berbagi file log — HANYA
             folder diag/ (lihat res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="animelovers.rebornhd.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
