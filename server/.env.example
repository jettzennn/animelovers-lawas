# Salin ke .env bila perlu mengubah nilai default. Semua punya default — server jalan tanpa file ini.
# JANGAN menulis rahasia/kunci apa pun di sini. Backend ini tidak butuh kunci.

# Port + alamat listen. Default 3100 di 127.0.0.1 (localhost Termux).
# Bila aplikasi di HP lain perlu mengakses server ini lewat WiFi, isi HOST=0.0.0.0.
PORT=3100
HOST=127.0.0.1

# Folder data (SQLite cache subtitle). Default: server/data/
# DATA_DIR=

# Email opsional untuk MyMemory (BUKAN kunci): parameter &de= menaikkan kuota
# gratis harian dari 5.000 menjadi 50.000 karakter. Boleh dikosongkan.
# MYMEMORY_EMAIL=
